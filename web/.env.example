# Copy to web/.env.local and fill in once Branch A posts the deployment.
# Every value here is public: Vite inlines it into the bundle.

# Deployed Pairwise address on Monad testnet. Unset or zero -> writes are disabled and the
# action panel drives the in-memory mock instead.
VITE_CONTRACT=

# Block the contract was deployed in.
VITE_START_BLOCK=

# Envio HyperIndex GraphQL endpoint. Unset -> the app serves the six mock duels.
VITE_ENVIO_URL=

# Pairwise server: uploads, insights and the gas drip. Unset -> Create keeps images local
# and sign-in skips the drip.
VITE_API_URL=http://localhost:8787
