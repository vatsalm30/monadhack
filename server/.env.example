# Server config. Never commit the filled-in file.

PORT=8787

# Prefix for returned upload URLs. These go into the contract and are permanent,
# so set the final public hostname BEFORE anyone posts a real duel.
PUBLIC_URL=http://localhost:8787

# Comma separated CORS allowlist (the web app's origins).
ALLOWED_ORIGINS=http://localhost:5173

# Hunyuan: upload moderation and post-duel insight. Unset -> moderation is skipped
# with a warning and /api/insight returns 404.
HUNYUAN_API_KEY=
# true = reject uploads when the moderation call itself fails. Default false (fail open).
MODERATION_STRICT=false

# Chain. CONTRACT_ADDRESS and ENVIO_URL are how /api/insight finds a duel:
# the indexer is tried first, the contract is the fallback.
RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=0xe4F3962C903a7e1bC45A2D0bD8A7F5b6379a3353
ENVIO_URL=

# Gas drip for new passkey accounts. Unset -> /api/drip returns 503.
FAUCET_PRIVATE_KEY=
FAUCET_DRIP_MON=0.05

# Where uploads, insights and the drip ledger live. Mount a volume here in production.
DATA_DIR=data
